ras de contenido. La usan las personas de la agencia (administradores, chatters y creadores) para atender los mensajes de las cuentas de las creadoras y organizar su trabajo. Esta política explica qué datos trata Model Pro, para qué y cómo pedir que se borren.`}),(0,B.jsx)(gy,{children:`Qué datos tratamos`}),(0,B.jsxs)(`ul`,{children:[(0,B.jsxs)(`li`,{children:[(0,B.jsx)(`b`,{children:`De las personas de la agencia:`}),` nombre, usuario, correo y la actividad dentro de la plataforma.`]}),(0,B.jsxs)(`li`,{children:[(0,B.jsx)(`b`,{children:`De las cuentas conectadas`}),` (páginas de Facebook, cuentas profesionales de Instagram, números de WhatsApp, cuentas y bots de Telegram): el identificador de la cuenta, su nombre y los permisos de acceso que la creadora autoriza al conectarla.`]}),(0,B.jsxs)(`li`,{children:[(0,B.jsx)(`b`,{children:`De quienes escriben a esas cuentas:`}),` el identificador que nos da cada plataforma, el nombre y la foto de perfil públicos, los mensajes de la conversación y los archivos que se envían en ella.`]})]}),(0,B.jsx)(gy,{children:`Para qué los usamos`}),(0,B.jsx)(`p`,{children:`Únicamente para mostrar y responder las conversaciones de las cuentas conectadas desde una bandeja compartida, organizar a quién atiende cada chat y llevar el registro interno de la agencia. No usamos los datos para publicidad, no los vendemos ni los compartimos con terceros con fines comerciales.`}),(0,B.jsx)(gy,{children:`Con quién se comparten`}),(0,B.jsx)(`p`,{children:`Los mensajes se envían y reciben a través de la plataforma de cada red (Meta, WhatsApp, Telegram), según sus propias condiciones. Dentro de la agencia, cada persona ve solo las conversaciones de las creadoras que tiene asignadas. Los datos se alojan en servidores contratados por la agencia.`}),(0,B.jsx)(gy,{children:`Cuánto tiempo se guardan`}),(0,B.jsx)(`p`,{children:`Mientras la cuenta esté conectada y la agencia la gestione. Al desvincular una cuenta se borran sus credenciales de acceso; al eliminar la línea se borran también sus conversaciones. Ante un pedido de eliminación, borramos los datos en un plazo máximo de 30 días.`}),(0,B.jsx)(gy,{children:`Seguridad`}),(0,B.jsx)(`p`,{children:`Las credenciales de acceso de las cuentas conectadas se guardan cifradas, la plataforma solo funciona sobre conexiones seguras (HTTPS) y el acceso de cada persona se limita según su rol y sus permisos.`}),(0,B.jsx)(gy,{children:`Tus derechos`}),(0,B.jsxs)(`p`,{children:[`Podés pedir acceso, corrección o eliminación de tus datos escribiendo a `,(0,B.jsx)(`a`,{href:`mailto:${py}`,children:py}),`. Para borrar los datos de una cuenta o de una conversación, seguí los pasos de `,(0,B.jsx)(Dn,{to:`/eliminacion-de-datos`,children:`Eliminación de datos`}),`.`]}),(0,B.jsx)(gy,{children:`Cambios`}),(0,B.jsx)(`p`,{children:`Si esta política cambia, publicamos la nueva versión en esta misma dirección con su fecha de actualización.`}),(0,B.jsx)(gy,{children:`English summary`}),(0,B.jsxs)(`p`,{children:[`Model Pro is the management platform of Pyro Models, a content creators agency. It processes the profile and messages of the conversations held with the Facebook Pages, Instagram professional accounts, WhatsApp numbers and Telegram accounts the creators connect, only to read and answer them from a shared inbox. Data is not sold, shared for advertising or used for any other purpose. Access tokens are stored encrypted. To request access to or deletion of your data, write to `,(0,B.jsx)(`a`,{href:`mailto:${py}`,children:py}),` or follow the `,(0,B.jsx)(Dn,{to:`/eliminacion-de-datos`,children:`data deletion instructions`}),`.`]})]})}function vy(){return(0,B.jsxs)(hy,{title:`Términos de servicio`,children:[(0,B.jsxs)(`p`,{children:[`Estos términos regulan el uso de Model Pro, la plataforma de gestión de Pyro Models. Al usar Model Pro o conectar una cuenta a ella, aceptás estos términos y la `,(0,B.jsx)(Dn,{to:`/privacidad`,children:`Política de privacidad`}),`.`]}),(0,B.jsx)(gy,{children:`Qué es Model Pro`}),(0,B.jsx)(`p`,{children:`Una herramienta interna de la agencia para gestionar a sus creadoras de contenido: sus cuentas, su contenido, su agenda y las conversaciones con sus seguidores. Permite conectar páginas de Facebook, cuentas profesionales de Instagram, números de WhatsApp y cuentas o bots de Telegram para leer y responder sus mensajes desde una bandeja compartida.`}),(0,B.jsx)(gy,{children:`Quién puede usarla`}),(0,B.jsx)(`p`,{children:`Solo las personas a las que la agencia les da un usuario. Cada una es responsable de mantener su contraseña en secreto y de usar únicamente las secciones y las creadoras que tiene asignadas. La agencia puede suspender o dar de baja un usuario en cualquier momento.`}),(0,B.jsx)(gy,{children:`Cuentas conectadas`}),(0,B.jsx)(`p`,{children:`Quien conecta una cuenta declara que es su titular o que tiene la autorización de su titular para hacerlo. La conexión puede retirarse en cualquier momento desde Model Pro («Desvincular») o desde la configuración de la propia red. El uso de cada red está sujeto también a sus propias condiciones (las de Meta, WhatsApp y Telegram).`}),(0,B.jsx)(gy,{children:`Uso aceptable`}),(0,B.jsx)(`p`,{children:`No está permitido usar Model Pro para:`}),(0,B.jsxs)(`ul`,{children:[(0,B.jsx)(`li`,{children:`enviar spam, mensajes masivos no solicitados o contenido engañoso;`}),(0,B.jsx)(`li`,{children:`infringir las políticas de las redes conectadas o la ley aplicable;`}),(0,B.jsx)(`li`,{children:`acosar, amenazar o suplantar a otras personas;`}),(0,B.jsx)(`li`,{children:`intentar acceder a datos, cuentas o secciones que no corresponden al usuario.`})]}),(0,B.jsx)(gy,{children:`Datos`}),(0,B.jsxs)(`p`,{children:[`El tratamiento de los datos se rige por la `,(0,B.jsx)(Dn,{to:`/privacidad`,children:`Política de privacidad`}),`. Para pedir la eliminación de datos, ver`,` `,(0,B.jsx)(Dn,{to:`/eliminacion-de-datos`,children:`Eliminación de datos`}),`.`]}),(0,B.jsx)(gy,{children:`Disponibilidad y responsabilidad`}),(0,B.jsx)(`p`,{children:`Model Pro se ofrece tal como está. Hacemos lo posible para que funcione sin interrupciones, pero puede haber cortes por mantenimiento o por fallas de las redes conectadas, que no dependen de nosotros. La agencia no responde por los daños indirectos que pudieran derivar del uso o la falta de disponibilidad de la plataforma.`}),(0,B.jsx)(gy,{children:`Cambios`}),(0,B.jsx)(`p`,{children:`Si estos términos cambian, publicamos la nueva versión en esta misma dirección con su fecha de actualización.`}),(0,B.jsx)(gy,{children:`English summary`}),(0,B.jsxs)(`p`,{children:[`Model Pro is an internal management tool of Pyro Models, used only by people the agency gives an account to. Whoever connects a Facebook Page, Instagram, WhatsApp or Telegram account declares they own it or are authorized by its owner, and can disconnect it at any time. Spam, misleading content, harassment and any use against the connected networks' policies or the law are not allowed. Data is handled as described in the `,(0,B.jsx)(Dn,{to:`/privacidad`,children:`Privacy Policy`}),`. The service is provided as is. Questions: `,(0,B.jsx)(`a`,{href:`mailto:${py}`,children:py}),`.`]})]})}function yy(){return(0,B.jsxs)(hy,{title:`Eliminación de datos`,children:[(0,B.jsx)(`p`,{children:`Podés pedir que borremos tus datos de Model Pro de cualquiera de estas formas.`}),(0,B.jsx)(gy,{children:`Si conectaste una cuenta (página de Facebook, Instagram, WhatsApp o Telegram)`}),(0,B.jsxs)(`ol`,{children:[(0,B.jsx)(`li`,{children:`Entrá a Model Pro y abrí la ficha de la creadora, en Cuentas y redes → Cuentas vinculadas.`}),(0,B.jsx)(`li`,{children:`Elegí la cuenta y tocá «Desvincular»: se borran en el momento las credenciales de acceso.`}),(0,B.jsx)(`li`,{children:`Para borrar también sus conversaciones, tocá «Borrar la línea y sus chats».`})]}),(0,B.jsx)(`p`,{children:`También podés quitar el acceso desde la propia red: en Facebook, Configuración → Integraciones comerciales (o Apps y sitios web), y en Instagram, Configuración → Apps y sitios web. Al quitarlo, Model Pro deja de recibir y enviar mensajes de esa cuenta.`}),(0,B.jsx)(gy,{children:`Si le escribiste a una cuenta atendida con Model Pro`}),(0,B.jsxs)(`p`,{children:[`Escribinos a `,(0,B.jsx)(`a`,{href:`mailto:${py}`,children:py}),` indicando la cuenta a la que escribiste y tu usuario o número en esa red. Borramos tu contacto, tus conversaciones y los archivos que enviaste en un plazo máximo de 30 días, y te confirmamos por el mismo medio.`]}),(0,B.jsx)(gy,{children:`English`}),(0,B.jsxs)(`p`,{children:[`To delete the data of a connected account, unlink it in Model Pro (the creator's profile → Linked accounts → «Desvincular», then «Borrar la línea y sus chats») or remove the app from your Facebook or Instagram settings. If you messaged an account managed with Model Pro, email`,` `,(0,B.jsx)(`a`,{href:`mailto:${py}`,children:py}),` with the account you wrote to and your username or number: we delete your contact, conversations and files within 30 days and confirm it to you.`]})]})}var by={today:`Hoy`,yesterday:`Ayer`,"7d":`Últimos 7 días`,"30d":`Últimos 30 días`,"90d":`Últimos 90 días`,month:`Este mes`,lastMonth:`Mes anterior`,all:`Todo`},xy=[[`today`,`Hoy`],[`yesterday`,`Ayer`],[`7d`,`7 días`],[`30d`,`30 días`],[`90d`,`90 días`],[`month`,`Este mes`],[`lastMonth`,`Mes anterior`]],Sy=[`enero`,`febrero`,`marzo`,`abril`,`mayo`,`junio`,`julio`,`agosto`,`septiembre`,`octubre`,`noviembre`,`diciembre`];function Cy(e){if(!e.startsWith(`custom:`))return null;let[,t,n]=e.split(`:`);return t&&n?{from:t,to:n}:null}var wy=e=>{let[t,n,r]=e.split(`-`).map(Number);return new Date(t,n-1,r)};function Ty(e,t=new Date){let n=Cy(e);if(n){let e=e=>e.split(`-`).reverse().slice(0,2).join(`/`);return`${e(n.from)} – ${e(n.to)}`}if(e===`lastMonth`){let e=new Date(t.getFullYear(),t.getMonth()-1,1);return`${Sy[e.getMonth()].replace(/^./,e=>e.toUpperCase())} ${e.getFullYear()}`}return by[e]}function Ey(e){switch